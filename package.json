{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:functions": "node scripts/sync-functions.mjs",
    "verify:functions": "node scripts/sync-functions.mjs --check",
    "predeploy": "npm run sync:functions && npm test && npm run build"
