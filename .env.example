# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================
# ADMIN AUTH — REQUIRED before deploying the backend anywhere reachable
# off your own machine. Without these set, the backend refuses every
# request (fail closed), on purpose. This is what stops a stranger who
# finds your public URL from placing real calls / sending real WhatsApp
# messages / reading your leads. Pick your own strong password.
# ============================================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"

# ============================================================
# WhatsApp Cloud API — used by server/index.js (npm run server)
# to actually send brochures/location/links to leads. Get these
# from developers.facebook.com. See the setup guide for steps.
# NEVER commit real values here — put them in .env.local instead.
# ============================================================
WHATSAPP_TOKEN="YOUR_META_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
WHATSAPP_GRAPH_VERSION="v20.0"
WHATSAPP_SERVER_PORT="8787"

# Content AIVA actually sends when a client asks:
WHATSAPP_BROCHURE_URL="https://example.com/brochure.pdf"
WHATSAPP_BROCHURE_FILENAME="AIVA_Property_Brochure.pdf"
WHATSAPP_BROCHURE_CAPTION="Here is the property brochure you asked for!"
WHATSAPP_LOCATION_NAME="AIVA Sales Office"
WHATSAPP_LOCATION_ADDRESS="Your office address here"
WHATSAPP_LOCATION_LAT="0.0"
WHATSAPP_LOCATION_LNG="0.0"
WHATSAPP_WEBSITE_URL="https://example.com/listings"
WHATSAPP_LINK_MESSAGE="Here is the link you asked for:"

# Inbound WhatsApp — lets AIVA see when a lead actually replies (not just send
# one-way messages). Pick any random strong string, then in Meta's App dashboard
# under WhatsApp > Configuration > Webhook, set the Callback URL to
# https://<your-domain>/api/whatsapp/webhook and paste this same value as the
# Verify Token. Subscribe to the "messages" field.
WHATSAPP_VERIFY_TOKEN="CHANGE_ME_TO_A_RANDOM_STRING"

# ============================================================
# Omnidimension (omnidim.io) — real outbound AI voice calling.
# Get OMNIDIM_API_KEY from https://omnidim.io/api-management
# Get your agent's numeric ID from the Omnidimension dashboard
# (or GET /calls/logs response, or list agents in the SDK) —
# set it via the app's Settings panel, not here, since it's
# meant to be admin-editable at runtime.
# ============================================================
OMNIDIM_API_KEY="YOUR_OMNIDIM_API_KEY"

# Server-side Gemini key used ONLY to analyze completed call transcripts
# and turn them into structured lead updates. This is separate from the
# Gemini key you paste into the app's Voice Agent settings (that one lives
# in the browser for the live chat; this one lives on the server for
# analyzing Omnidimension call webhooks).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# IMPORTANT: Omnidimension's servers must be able to reach your webhook
# endpoint (POST /api/omnidim/webhook) over the public internet. On your
# local machine, localhost is NOT reachable from Omnidimension — use a
# tunnel like ngrok (`ngrok http 8787`) during development, and set the
# resulting public URL as the agent's post_call_actions.webhook.url in
# the Omnidimension dashboard.
